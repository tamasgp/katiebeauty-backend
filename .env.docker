# Docker Compose environment variables
# ⚠️  IMPORTANT: These are LOCAL DEVELOPMENT defaults only.
#     NEVER use these values in production. Change all passwords and secrets before any deployment.
# To use: docker-compose --env-file .env.docker up

# PostgreSQL
POSTGRES_DB=katiebeauty
POSTGRES_USER=katiebeauty
# ⚠️  Change before deploying to production
POSTGRES_PASSWORD=secure-password-change-me

# Backend
NODE_ENV=development
PORT=3001
# ⚠️  Change before deploying to production (use a long, random string)
JWT_SECRET=development-secret-key
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@katiebeauty.hu
ADMIN_NAME=Katie Beauty Admin
# ⚠️  Change before deploying to production
ADMIN_PASSWORD=admin-password-change-me
