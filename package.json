{
  "name": "katiebeauty-backend",
  "version": "1.0.0",
  "description": "Katie Beauty backend API built with Fastify",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
